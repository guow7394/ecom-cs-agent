# ---- DeepSeek（Anthropic 兼容接口，跑 Agent 和 "llm" 判断层）----
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=sk-your-deepseek-key
# deepseek-v4-flash 便宜快；deepseek-v4-pro 更强。不认识的名字会被 DeepSeek 回落到 flash。
MODEL_ID=deepseek-v4-flash

# ---- TypeSafe Jev（判断层）----
TYPESAFE_API_KEY=your-typesafe-key
# 做实验建议固定版本号（jev-latest 是会移动的别名，换版本后阈值需要重新标定）
JEV_MODEL=jev-1.13.0

# ---- 业务 ----
# 判断层阈值 τ：置信度低于它就转人工（敏感意图自动 +0.1）
HANDOFF_THRESHOLD=0.5
# 第二道判断题：needs_human 概率 ≥ 该值也转人工（意图清楚但不是标准情况）
NEEDS_HUMAN_THRESHOLD=0.5
# 固定"今天"，保证退货时效等规则和实验可复现
CS_TODAY=2026-10-13
